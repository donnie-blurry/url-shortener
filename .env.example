DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME
REDIS_URL=redis://localhost:6379/0

# Optional settings shown with their defaults.
# DATABASE_CONNECT_TIMEOUT_SECONDS=5
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# REDIS_KEY_PREFIX=url-shortener
# REDIS_CONNECT_TIMEOUT_SECONDS=0.2
# REDIS_CACHE_TIMEOUT_SECONDS=0.2
# REDIS_PUBLISH_TIMEOUT_SECONDS=0.2
# REDIS_WORKER_TIMEOUT_SECONDS=5
# CACHE_TTL_SECONDS=3600
# MAX_CODE_ATTEMPTS=5
# Enable a separate metrics listener for this process by setting METRICS_PORT.
# METRICS_HOST=127.0.0.1
# METRICS_PORT=9100
