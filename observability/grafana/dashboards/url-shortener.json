{
  "id": null,
  "uid": "url-shortener",
  "title": "URL Shortener",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "url-shortener"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "description": "Completed responses by route. Health checks are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "url-shortener-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(url_shortener_http_request_duration_seconds_count{job=\"url-shortener-api\",route!=\"/health\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP response status",
      "description": "Requests per second by response status class. Health checks are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "url-shortener-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(url_shortener_http_request_duration_seconds_count{job=\"url-shortener-api\",route!=\"/health\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP response time",
      "description": "Server-side response latency by route. Health checks are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "url-shortener-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (method, route, le) (rate(url_shortener_http_request_duration_seconds_bucket{job=\"url-shortener-api\",route!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "p50 {{method}} {{route}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (method, route, le) (rate(url_shortener_http_request_duration_seconds_bucket{job=\"url-shortener-api\",route!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "p95 {{method}} {{route}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (method, route, le) (rate(url_shortener_http_request_duration_seconds_bucket{job=\"url-shortener-api\",route!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "p99 {{method}} {{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Visit processing attempts",
      "description": "Each retry counts separately. Acknowledged attempts include replays.",
      "datasource": {
        "type": "prometheus",
        "uid": "url-shortener-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(url_shortener_visit_processing_duration_seconds_count{job=\"url-shortener-worker\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Visit processing time",
      "description": "p95 processing time by outcome across all worker replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "url-shortener-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (outcome, le) (rate(url_shortener_visit_processing_duration_seconds_bucket{job=\"url-shortener-worker\"}[$__rate_interval])))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape target health",
      "description": "1 means Prometheus can scrape the listener. 0 means the scrape failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "url-shortener-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"url-shortener-api|url-shortener-worker\"}",
          "legendFormat": "{{job}} {{instance}}",
          "range": true
        }
      ]
    }
  ]
}
